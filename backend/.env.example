# demo: the backend reports demo mode and the frontend simulates the night itself.
# live: /api/scenario builds a real scenario from OpenSky + ERA5 + pycontrails.
UAL_MODE=demo

# Scenario window (UTC). Start hour and length in hours.
UAL_START=2026-10-10T21:00
UAL_HOURS=12
# lon_min,lat_min,lon_max,lat_max
UAL_BBOX=-82,26,14,68
UAL_MAX_FLIGHTS=80

# OpenSky Network API client (OAuth2 client credentials, created in your OpenSky account page)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Local copy of the OpenSky aircraft metadata CSV, used to map icao24 -> aircraft type
OPENSKY_AIRCRAFT_DB=data/aircraftDatabase.csv

# Copernicus Climate Data Store. cdsapi also reads ~/.cdsapirc if these are blank.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Contrails.org observations API (confirm base URL and auth against their docs)
CONTRAILS_ORG_URL=
CONTRAILS_ORG_KEY=

# MongoDB Atlas connection string. Leave blank here; set the real value in your own .env or in your host's environment variables.
MONGO_URI=

# Where finished scenarios are cached
UAL_CACHE_DIR=.cache
